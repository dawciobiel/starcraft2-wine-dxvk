#!/bin/bash
# -----------------------------------------------------------------------------
# Script Name: wineboot-update.sh
# Description: Run `wineboot -u` to update or repair the Wine prefix.
#              This is useful after upgrading Wine or changing configuration,
#              as it can fix issues with applications that stopped working.
#
# Usage:       ./wineboot-update.sh
# Config:      Requires a `wine.conf` file in the same directory that defines
#              WINE_HOME (path to Wine installation).
#
# Author:      Dawid Bielecki (https://github.com/dawciobiel)
# License:     MIT
# Version:     1.1
# Date:        17.11.2025
# -----------------------------------------------------------------------------

# set -euo pipefail

SCRIPT_DIR="$(dirname "$0")"
CONF_FILE="$SCRIPT_DIR/wine.conf"

# Load centralized logging functions
if [[ ! -f "$SCRIPT_DIR/logger.sh" ]]; then
    echo -e "\033[0;31mERROR\033[0m: Missing logger.sh script" >&2
    exit 1
fi
source "$SCRIPT_DIR/logger.sh"

# === Configuration ===
if [[ ! -f "$CONF_FILE" ]]; then
    log_error_console "Configuration file $CONF_FILE not found."
    exit 1
fi

# Load configuration
source "$CONF_FILE"

# Validate WINE_HOME
if [[ -z "${WINE_HOME:-}" ]]; then
    log_error_console "WINE_HOME is not set in $CONF_FILE."
    exit 1
fi

# Validate wineboot binary
if [[ ! -x "$WINE_HOME/bin/wineboot" ]]; then
    log_error_console "wineboot not found in $WINE_HOME/bin/"
    exit 1
fi

# Run wineboot update
"$WINE_HOME/bin/wineboot" -u

log_info_console "wineboot -u completed successfully."
